FROM node:18-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install
COPY . .

# Pre-create the directories that will be bind-mounted as named volumes at runtime.
# The named volumes in docker-compose are stored on the real host filesystem
# (/var/lib/docker/volumes/), making their disk usage visible to node_exporter
# and therefore observable by the HighDiskUtilization Prometheus alert.
RUN mkdir -p /app/logs /app/temp

EXPOSE 5000

CMD ["node", "server.fault-disk-full.js"]
